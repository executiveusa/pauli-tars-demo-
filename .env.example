# BARS sovereign runtime environment — NAMES ONLY. Real values live in
# Infisical / Coolify secrets, never in git. Copy to /opt/bars/.env on the VPS.

# --- Hermes execution engine (NEW: primary BARS brain) ---
# Run a current NousResearch/hermes-agent gateway/API server separately.
# BARS web/Vercel is a thin control/UI surface; the persistent Hermes runtime
# belongs on a host where tools, memory, skills and long-running jobs can live.
# HERMES_REMOTE_URL=https://your-hermes-runtime.example.com
# HERMES_API_KEY=                         # API_SERVER_KEY from Hermes runtime
# BARS_HERMES_MODEL=hermes-agent
# BARS_HERMES_PROFILE=bars

# --- connected-app / creative adapters ---
# Composio is configured in Hermes as MCP; these variables are only optional
# discovery/status hints for BARS and must never be sent to the browser.
# COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
# BARS_COMPOSIO_TOKEN=                 # preferred: injected from Infisical/Coolify at runtime
# COMPOSIO_API_KEY=                      # legacy compatibility fallback
# OPENSUNO_URL=https://your-opensuno-adapter.example.com
# VISUAL_PROVIDER_URL=                    # Phyla or another verified provider adapter

# --- existing provider runtime ---
GROQ_API_TOKEN=            # free-tier Groq key (Infisical HERMES: GROQ_API_TOKEN)
BARS_OPERATOR_TOKEN=       # long random bearer for the private cockpit APIs

# --- routing (legacy/local provider lanes; Hermes may supersede these) ---
# BARS_FLASH_MODEL=openai/gpt-oss-20b
# BARS_WORKER_MODEL=openai/gpt-oss-120b
# BARS_REASONER_MODEL=openai/gpt-oss-120b
# BARS_JUDGE_MODEL=openai/gpt-oss-120b
# BARS_MODEL=openai/gpt-oss-120b        # static fallback brain (duplex/vision)
# BARS_MAX_TOKENS_CAP=4096              # hard per-call cap

# --- paid escalation: fail-closed by default. Enable only deliberately. ---
# BARS_ALLOW_PAID=0
# BARS_PAID_TOKEN_BUDGET=100000         # hard daily token budget when enabled
# BARS_FREE_PROVIDERS=api.groq.com      # explicit free-provider allowlist
# AI_GATEWAY_API_KEY=                   # Vercel AI Gateway (paid) if ever used

# --- proxy / client-IP attribution ---
# XFF is only consulted when the immediate peer is trusted (default: loopback).
# If Caddy (or any reverse proxy) reaches BARS from a NON-loopback address -
# host systemd Caddy behind a provider NAT, a docker bridge IP, etc. - every
# client collapses into one shared identity: shared rate limits, shared login
# lockouts. List those proxy peer IPs here (comma-separated):
# BARS_TRUSTED_PROXIES=127.0.0.1,10.0.0.1
# OPEN_ROUTER_API=                      # OpenRouter fallback
# ANTHROPIC_API_KEY=                    # Anthropic native fallback

# --- voice (optional; Groq STT/TTS rides the free key automatically) ---
# ELEVEN_LABS_API=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=                       # realtime live voice + OpenAI STT
# BARS_STT_MODEL=whisper-large-v3-turbo
# BARS_TTS_MODEL=orpheus-v1-english
# BARS_TTS_VOICE=autumn
# Rime lane (the decided BARS voice, speaker "bond") - tried first when set.
# Key lives in Infisical under the "Synthia 3.0" project (the HERMES identity
# cannot read it; fetch with an identity that can). ~800 free minutes, then
# ~$0.03/audio-minute. Without it: ElevenLabs -> Groq -> browser speech.
# RIME_API_KEY=            # (RIME_API_TOKEN also accepted - Infisical name)
# RIME_SPEAKER=bond        # (alias of RIME_VOICE; either wins)
# RIME_VOICE=bond
# RIME_MODEL=arcana
# RIME_TTS_URL=https://users.rime.ai/v1/rime-tts

# --- fleet wiring (optional; console FLEET panel + persona fleet awareness) ---
# Read-only canonical city-state token (Infisical: CANONICAL_API_TOKEN).
# Without it the FLEET panel shows "fleet token not configured" - never fake data.
# BARS_FLEET_API_TOKEN=
# BARS_FLEET_API_URL=https://api.thepaulieffect.com/mission-control/api/canonical

# --- security / runtime ---
# Production: the cockpit is served same-origin by Caddy, so the allowlist only
# needs cross-origin callers (the static Netlify mirror). Comma-separated, https only.
BARS_ALLOWED_ORIGINS=https://barsdemo.netlify.app
# BARS_DATA_DIR=/data
# BARS_INTERNAL_WORKER=1                # provider-only missions when no CLI
# BARS_DISABLE_HANDS=1                  # never machine-control on the VPS
# BARS_GIT_SHA=                         # baked at deploy time for /health truth
# --- review-hardening v1 ---
# BARS_OPEN_LOCAL=1            # DANGEROUS dev-only: run with no operator auth (default fail-closed)
# BARS_ALLOW_LOCAL_DEV=1       # allow http://localhost origins (default 1; set 0 in prod)
# BARS_MISSION_RESUME=1        # auto-resume missions that were EN ROUTE at crash (default: mark FAILED)
# receipts: HMAC chain key auto-generated at $BARS_DATA_DIR/.receipts.key (0600); ledger at receipts.jsonl
# budget:   durable reservation ledger at $BARS_DATA_DIR/budget.json (0600)
