{
  "schema_version": 2,
  "name": "bars-hermes-overlay",
  "description": "Portable BARS overlay extracted from Pauli Hermes and applied to a clean current NousResearch/hermes-agent base.",
  "upstream": {
    "repository": "NousResearch/hermes-agent",
    "verified_commit_2026_09_16": "8c8003f80b528377d4387b96faa2c00283168d68"
  },
