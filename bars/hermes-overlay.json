      "secret_location": "runtime only"
    },
    {
      "id": "opensuno",
      "kind": "mcp-or-http",
      "repository": "paean-ai/opensuno",
      "secret_location": "adapter runtime only"
    },
    {
      "id": "visual-provider",
      "kind": "provider-adapter",
      "note": "Use this boundary for Phyla or any later image/video provider after its current API is verified."
    }
