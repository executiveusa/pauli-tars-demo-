# BARS Hermes sidecar — NAMES ONLY. Never commit real values.
# Copy to /opt/bars/hermes.env on the sovereign host and chmod 600.

# Required: use an exact immutable image reference in production.
# Example form: nousresearch/hermes-agent@sha256:<digest>
HERMES_IMAGE=

# Required API authentication. Generate a long random value and store it in the secret manager.
API_SERVER_KEY=
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642

# Provider credentials required by the chosen Hermes model route.
# Configure only the provider(s) actually used; do not copy BARS browser secrets into this file.
# NOUS_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Optional MCP/app integrations. Prefer OAuth/scoped MCP credentials inside Hermes' persistent data volume.
# COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
# OPENSUNO_URL=
# VISUAL_PROVIDER_URL=

# BARS profile/skill data persists under /opt/bars/hermes on the host.
# Do not run a second Hermes gateway against the same data directory.
