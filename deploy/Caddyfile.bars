# Caddy vhost for sovereign BARS. Append to the existing Caddyfile on the VPS
# (do NOT replace it — StarNet/Command Center/terabithia routes live there).
# DNS: bars.thepaulieffect.com A 31.220.58.212 (DNS-only in Cloudflare).
#
# BARS stays on loopback :4321. Hermes stays on loopback :8642 and is only
# reachable externally through /hermes/*, where Hermes' API_SERVER_KEY bearer
# authentication is still mandatory. The Hermes dashboard is not exposed.

bars.thepaulieffect.com {
	encode zstd gzip

	# Authenticated Hermes API bridge used by the Vercel BARS facade.
	# handle_path strips /hermes before proxying, so:
	#   /hermes/v1/responses -> Hermes /v1/responses
	#   /hermes/v1/runs      -> Hermes /v1/runs
	handle_path /hermes/* {
		reverse_proxy 127.0.0.1:8642
	}

	# All other routes stay on the sovereign BARS runtime.
	handle {
		reverse_proxy 127.0.0.1:4321
	}

	# Optional second gate for the BARS cockpit only should be implemented in
	# the app/session layer; do not put a global basic_auth here or it will also
	# interfere with the API-key-authenticated Hermes bridge.

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
